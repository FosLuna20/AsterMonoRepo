<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>StartDateRequired</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( Status__c, &apos;Completed&apos;), ISBLANK(Start_Date__c ) )</errorConditionFormula>
    <errorDisplayField>Start_Date__c</errorDisplayField>
    <errorMessage>You cannot put Start Date as Blank</errorMessage>
</ValidationRule>
